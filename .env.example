# Every setting the site reads. Copy to .env.local and fill in what you need;
# in production, set the same names in the hosting settings.

# Email (Resend). The sender must be on a domain verified in the account.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@breadegg.com
# Optional, defaults to "Breadegg <hello@breadegg.com>".
RESEND_FROM=

# Bookings are stored in Cloudflare D1 (the BOOKINGS binding in wrangler.jsonc),
# not in an env variable; `next dev` keeps them in memory.
# On Cloudflare, CONTACT_TO_EMAIL is a var in wrangler.jsonc and RESEND_API_KEY a
# secret: npx wrangler secret put RESEND_API_KEY

# Public values, shipped in the page.
NEXT_PUBLIC_SITE_URL=https://breadegg.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@breadegg.com
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty: no analytics, no banner.
NEXT_PUBLIC_GA_ID=
# Stripe Payment Link for the subscription. Empty: "Start today" opens the contact form.
NEXT_PUBLIC_SUBSCRIBE_URL=
